# Example environment variables
# Copy this file to .env.local and fill in the values

# Database URL (optional for now, using localStorage)
# DATABASE_URL=postgresql://user:password@localhost:5432/chichadb

# NextAuth (for future authentication)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key-here

# API Keys (all optional, using free services)
# No API keys needed for OpenStreetMap/Nominatim
